# 复制为 .env 后按需修改；直接 export 也可以
# 注意：本项目不自动加载 .env，需要你自己 source / 用 set -a 导出

# ---- 路径 ----
FQ_DB=./fq_books.db
FQ_MAP=./mapping.json
FQ_PLAN=./cats.json

# ---- 网络 ----
# 出口代理，留空=直连；多个出口用逗号分隔（fq_enum2 支持轮换）
FQ_PROXY=
# FQ_PROXY=http://127.0.0.1:7890
# FQ_PROXIES=http://a:7890,http://b:7890

# ---- Web 面板 ----
# 默认 127.0.0.1（只本机可访问）。要让局域网访问，改成 0.0.0.0 并务必设口令
FQ_PANEL_HOST=127.0.0.1
FQ_PANEL_PORT=18081
# 生成：python -c "import secrets;print(secrets.token_urlsafe(16))"
FQ_PANEL_TOKEN=

# ---- 下载引擎（可选，本仓库不含） ----
FQ_ENGINE=http://127.0.0.1:18430
FQ_ENGINE_PWD=

# ---- 每日增量（fq_daily.py） ----
FQ_INCR_AT=03:00
FQ_INCR_DAYS=3
FQ_INCR_PAGES=3
